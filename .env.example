# MuleTracer Environment Configuration
DATABASE_URL=sqlite:///./muletracer.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
DEFAULT_DATASET_SEED=42
NEXT_HOP_WINDOW_SECONDS=300
MULE_RISK_THRESHOLD=65
CRITICAL_RISK_THRESHOLD=85

# Google Gemini / GraphRAG LLM Key (Optional - system automatically uses deterministic offline fallback if not set)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
